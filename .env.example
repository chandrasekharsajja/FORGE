# FORGE Environment Configuration Template
# Copy this to .env.local (which is ignored by git) and fill in your values

# General Application Settings
NODE_ENV=production
PORT=3000

# Database Connection (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=forge_user
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DATABASE=forge_db

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=optional-redis-auth-password

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=optional-api-key-for-authentication

# AI/LLM Provider API Keys - THESE ARE SENSITIVE AND SHOULD NEVER BE COMMITTED
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# JWT Authentication Secret (should be long random string)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_MS=60000

# Service-Specific Configuration
MEMORY_SERVICE_MAX_CACHE_SIZE=10000
POLICY_ENGINE_DEBUG_MODE=false

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# For development/testing only - DO NOT USE IN PRODUCTION
SKIP_SECRET_CHECK=false

# Storage Configuration
ARTIFACT_STORAGE_ROOT=/tmp/forge-artifacts

# Workspace Management
WORKSPACE_MAX_REPOS_PER_WORKSPACE=10
WORKSPACE_DEFAULT_TTL_HOURS=24

# Security Headers (CSP, etc.)
SECURE_COOKIE=true
SESSION_COOKIE_NAME=forge-session-id