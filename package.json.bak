{
  "name": "@sajja/forge-monorepo",
  "version": "0.9.0-rc1",
  "private": true,
  "description": "FORGE AI Engineering OS Monorepo by Sajja",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/sdks/*",
    "services/*"
  ],
  "engines": {
    "node": ">=18.0.0 <21.0.0"
  },
  "scripts": {
    "dev:studio": "npm run dev --workspace @sajja/forge-studio",
    "build:studio": "npm run build --workspace @sajja/forge-studio",
    "start:studio": "npm run start --workspace @sajja/forge-studio",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "node test-jwt.js && node test-crud.js && node test-blog.js && node test-oauth.js && node test-payment.js && node test-k8s.js && node test-bugfix.js && node test-refactor.js && node test-browser.js && node test-multirepo.js",
    "test:ref": "npm run test",
    "test:jwt": "node test-jwt.js",
    "test:crud": "node test-crud.js",
    "test:k8s": "node test-k8s.js",
    "test:unit": "vitest run",
    "test:integration": "node --experimental-test-runner tests/integration/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "npx vitest run --coverage",
    "test:ci": "npm run lint && npm run format:check && npm run type-check && npm run unit-tests"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "prettier": "^3.3.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "husky": "^9.0.6",
    "lint-staged": "^15.2.0",
    "vitest": "^1.6.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "complexity-metric": "^0.1.0",
    "dependency-cruiser": "^11.7.5",
    "jscpd": "^4.3.0"
  }
}